{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "aibal.ai",
  "colors": {
    "primary": "#0D9488",
    "light": "#5EEAD4",
    "dark": "#042F2E"
  },
  "favicon": {
    "light": "/favicon.svg",
    "dark": "/favicon.svg"
  },
  "navigation": {
    "languages": [
      {
        "language": "zh",
        "default": true,
        "groups": [
          {
            "group": "使用指南",
            "pages": [
              "zh/selling-points",
              "zh/register",
              "zh/recharge",
              "zh/create-api-key",
              {
                "group": "文生视频",
                "pages": ["zh/text-to-video"]
              },
              {
                "group": "文生图",
                "pages": ["zh/text-to-image"]
              },
              "zh/integrations"
            ]
          }
        ]
      },
      {
        "language": "en",
        "groups": [
          {
            "group": "User guide",
            "pages": [
              "en/selling-points",
              "en/register",
              "en/recharge",
              "en/create-api-key",
              {"group": "Text to video", "pages": ["en/text-to-video"]},
              {"group": "Text to image", "pages": ["en/text-to-image"]},
              "en/integrations"
            ]
          }
        ]
      },
      {
        "language": "ru",
        "groups": [
          {
            "group": "Руководство пользователя",
            "pages": [
              "ru/selling-points",
              "ru/register",
              "ru/recharge",
              "ru/create-api-key",
              {"group": "Текст в видео", "pages": ["ru/text-to-video"]},
              {"group": "Текст в изображение", "pages": ["ru/text-to-image"]},
              "ru/integrations"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": []
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "打开 aibal.ai 控制台",
        "href": "https://aibal.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "进入控制台",
      "href": "https://aibal.ai"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/EarlyBedEarlyUp/Aibal"
    }
  }
}
