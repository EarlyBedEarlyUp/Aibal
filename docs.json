{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "aibal.ai",
  "colors": {
    "primary": "#0D9488",
    "light": "#5EEAD4",
    "dark": "#042F2E"
  },
  "favicon": {
    "light": "/favicon.svg",
    "dark": "/favicon.svg"
  },
  "navigation": {
    "languages": [
      {
        "language": "zh",
        "default": true,
        "href": "/zh"
      },
      {
        "language": "en",
        "href": "/en"
      },
      {
        "language": "ru",
        "href": "/ru"
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://mintlify.com/blog",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "aibal.ai 控制台",
        "href": "https://aibal.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/EarlyBedEarlyUp/Aibal"
    }
  }
}
